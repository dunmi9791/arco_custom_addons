<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Payment approval (SMERP step "Payment Approval"); company currency -->
    <record id="tier_pv_finance_manager" model="tier.definition">
        <field name="company_id" eval="False"/>
        <field name="name">Payment Voucher - Finance Manager (all)</field>
        <field name="model_id" ref="model_arco_payment_run"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="arco_base.group_arco_finance_approver"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">30</field>
        <field name="approve_sequence" eval="True"/>
    </record>
    <record id="tier_pv_finance_director" model="tier.definition">
        <field name="company_id" eval="False"/>
        <field name="name">Payment Voucher - Finance Director (above N5m)</field>
        <field name="model_id" ref="model_arco_payment_run"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="arco_base.group_arco_finance_director"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[("amount_total", "&gt;", 5000000)]</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
    </record>
    <record id="tier_pv_executive" model="tier.definition">
        <field name="company_id" eval="False"/>
        <field name="name">Payment Voucher - Executive Management (above N20m)</field>
        <field name="model_id" ref="model_arco_payment_run"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="arco_base.group_arco_md"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[("amount_total", "&gt;", 20000000)]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
    </record>
</odoo>
