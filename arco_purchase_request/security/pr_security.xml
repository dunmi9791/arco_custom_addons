<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pr_own" model="ir.rule">
        <field name="name">PR: requisitioners see their own / department requests</field>
        <field name="model_id" ref="model_arco_purchase_request"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_pr_all" model="ir.rule">
        <field name="name">PR: procurement and approvers see all</field>
        <field name="model_id" ref="model_arco_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('arco_base.group_arco_dept_manager')), (4, ref('arco_base.group_arco_finance_approver'))]"/>
    </record>
    <record id="rule_pr_company" model="ir.rule">
        <field name="name">PR: multi-company</field>
        <field name="model_id" ref="model_arco_purchase_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
