<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_arco_pr" model="ir.ui.view">
        <field name="name">purchase.order.form.arco.pr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_arco_requests" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="arco_request_count == 0">
                    <field name="arco_request_count" widget="statinfo" string="Requisitions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
