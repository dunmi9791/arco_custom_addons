<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arco_pr_list" model="ir.ui.view">
        <field name="name">arco.purchase.request.list</field>
        <field name="model">arco.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancel','rejected')" decoration-info="state == 'submitted'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date_request"/>
                <field name="requested_by" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="project_id" optional="show"/>
                <field name="date_required" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state in ('approved','done')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_arco_pr_form" model="ir.ui.view">
        <field name="name">arco.purchase.request.form</field>
        <field name="model">arco.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_rfq" string="Create RFQ / PO" type="object" class="btn-primary" invisible="state != 'approved'" groups="purchase.group_purchase_user"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted','rejected','cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done','cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="purchase_count == 0">
                            <field name="purchase_count" widget="statinfo" string="RFQs / POs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requested_by" readonly="state != 'draft'"/>
                            <field name="dept_manager_user_id" widget="many2one_avatar_user"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="picking_type_id" readonly="state not in ('draft','approved')"/>
                        </group>
                        <group>
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="estimated_unit_cost"/>
                                    <field name="vendor_id"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" groups="analytic.group_analytic_accounting"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="qty_ordered" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Justification" name="justification">
                            <field name="justification" placeholder="Why is this needed? Which job / work order / project?"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_arco_pr_search" model="ir.ui.view">
        <field name="name">arco.purchase.request.search</field>
        <field name="model">arco.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requested_by"/>
                <field name="project_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="my" string="My Requisitions" domain="[('requested_by', '=', uid)]"/>
                <filter name="to_approve" string="Awaiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved (to convert)" domain="[('state', '=', 'approved')]"/>
                <filter name="urgent" string="Urgent / Critical" domain="[('priority', 'in', ['1', '2'])]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_arco_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Requisitions</field>
        <field name="res_model">arco.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise your first purchase requisition</p>
            <p>Requisitions are approved through the ARCO authorization matrix before Procurement converts them into RFQs and Purchase Orders.</p>
        </field>
    </record>

    <menuitem id="menu_arco_pr_root" name="Requisitions" sequence="24" web_icon="purchase,static/description/icon.svg"/>
    <menuitem id="menu_arco_pr_all" name="Purchase Requisitions" parent="menu_arco_pr_root" action="action_arco_purchase_request" sequence="10"/>
    <menuitem id="menu_arco_pr_purchase" name="Purchase Requisitions" parent="purchase.menu_procurement_management" action="action_arco_purchase_request" sequence="1"/>
</odoo>
