<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arco_asset_transfer_list" model="ir.ui.view">
        <field name="name">arco.asset.transfer.list</field>
        <field name="model">arco.asset.transfer</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancel','rejected')" decoration-info="state in ('submitted','approved')">
                <field name="name"/>
                <field name="date"/>
                <field name="asset_ids" widget="many2many_tags"/>
                <field name="to_employee_id"/>
                <field name="to_location_id"/>
                <field name="requested_by" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('submitted','approved')"/>
            </list>
        </field>
    </record>
    <record id="view_arco_asset_transfer_form" model="ir.ui.view">
        <field name="name">arco.asset.transfer.form</field>
        <field name="model">arco.asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"/>
                    <button name="action_receive" string="Acknowledge Receipt" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('rejected','cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done','cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Transfer">
                            <field name="date" readonly="state not in ('draft',)"/>
                            <field name="asset_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="requested_by"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group string="Destination">
                            <field name="to_employee_id" readonly="state != 'draft'"/>
                            <field name="to_department_id" readonly="state != 'draft'"/>
                            <field name="to_location_id" readonly="state != 'draft'"/>
                            <field name="change_cost_centre" readonly="state != 'draft'"/>
                            <field name="analytic_distribution" widget="analytic_distribution" invisible="not change_cost_centre" readonly="state != 'draft'" groups="analytic.group_analytic_accounting"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason for the transfer (reassignment, project mobilisation, repair...)" readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Assets Moved" name="lines" invisible="state == 'draft'">
                            <field name="line_ids">
                                <list>
                                    <field name="asset_id"/>
                                    <field name="from_employee_id"/>
                                    <field name="from_department_id"/>
                                    <field name="from_location_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Receipt" name="receipt" invisible="state not in ('approved','done')">
                            <group>
                                <group>
                                    <field name="approved_by"/>
                                    <field name="received_by"/>
                                    <field name="date_received"/>
                                    <field name="condition_on_receipt" readonly="state == 'done'"/>
                                </group>
                                <group>
                                    <field name="receiver_signature" widget="signature" readonly="state == 'done'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_arco_asset_transfer_search" model="ir.ui.view">
        <field name="name">arco.asset.transfer.search</field>
        <field name="model">arco.asset.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_ids"/>
                <field name="to_employee_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted','approved'))]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>
    <record id="action_arco_asset_transfer" model="ir.actions.act_window">
        <field name="name">Asset Transfers</field>
        <field name="res_model">arco.asset.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_arco_asset_transfer" name="Asset Transfers" parent="account_asset_management.menu_finance_assets" action="action_arco_asset_transfer" sequence="20"/>
</odoo>
