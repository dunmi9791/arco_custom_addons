<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Discount approval: 0-5% Sales Executive (no approval), 5-15% Sales Manager, >15% Commercial Director -->
    <record id="tier_so_sales_manager" model="tier.definition">
        <field name="company_id" eval="False"/>
        <field name="name">Sales Order - Sales Manager (discount 5-15%)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="sales_team.group_sale_manager"/>
        <field name="definition_domain">[("arco_max_discount", "&gt;", 5), ("arco_max_discount", "&lt;=", 15)]</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
    </record>
    <record id="tier_so_commercial_director" model="tier.definition">
        <field name="company_id" eval="False"/>
        <field name="name">Sales Order - Commercial Director (discount above 15%)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="arco_base.group_arco_commercial_director"/>
        <field name="definition_domain">[("arco_max_discount", "&gt;", 15)]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
    </record>
</odoo>
