<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Finance verification / approval tiers must see every claim they review -->
    <record id="rule_expense_sheet_finance" model="ir.rule">
        <field name="name">Expense reports: finance reviewers</field>
        <field name="model_id" ref="hr_expense.model_hr_expense_sheet"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')), (4, ref('arco_base.group_arco_finance_approver'))]"/>
    </record>
    <record id="rule_expense_finance" model="ir.rule">
        <field name="name">Expenses: finance reviewers</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')), (4, ref('arco_base.group_arco_finance_approver'))]"/>
    </record>
</odoo>
