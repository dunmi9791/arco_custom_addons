<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_arco" model="ir.module.category">
        <field name="name">ARCO Roles</field>
        <field name="sequence">5</field>
    </record>
    <record id="group_arco_requisitioner" model="res.groups">
        <field name="name">Requisitioner</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_arco_dept_manager" model="res.groups">
        <field name="name">Department Manager (Approver L1)</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_requisitioner'))]"/>
    </record>
    <record id="group_arco_finance_approver" model="res.groups">
        <field name="name">Finance Manager (Approver L2)</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_requisitioner'))]"/>
    </record>
    <record id="group_arco_finance_director" model="res.groups">
        <field name="name">Finance Director</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_finance_approver'))]"/>
    </record>
    <record id="group_arco_commercial_director" model="res.groups">
        <field name="name">Commercial Director</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_requisitioner'))]"/>
    </record>
    <record id="group_arco_legal" model="res.groups">
        <field name="name">Legal Reviewer</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_requisitioner'))]"/>
    </record>
    <record id="group_arco_pmo" model="res.groups">
        <field name="name">PMO</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_requisitioner'))]"/>
    </record>
    <record id="group_arco_md" model="res.groups">
        <field name="name">Executive Management / MD (Approver L3)</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('group_arco_dept_manager')), (4, ref('group_arco_finance_director'))]"/>
    </record>
    <record id="group_arco_auditor" model="res.groups">
        <field name="name">Internal Auditor (read-only audit trail)</field>
        <field name="category_id" ref="module_category_arco"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
