<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_arco" model="ir.ui.view">
        <field name="name">product.template.form.arco</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="arco_equipment_class"/>
                <field name="arco_is_critical"/>
                <field name="arco_hs_code"/>
            </xpath>
        </field>
    </record>
</odoo>
