<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_arco_fs" model="ir.ui.view">
        <field name="name">res.config.settings.arco.fs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="after">
                <block title="Management Reporting" id="arco_fs_settings">
                    <setting string="Monthly P&amp;L" help="On the 1st of each month, email last month's P&amp;L (PDF) to management">
                        <field name="arco_monthly_pl_enabled"/>
                        <div class="content-group" invisible="not arco_monthly_pl_enabled">
                            <field name="arco_monthly_pl_partner_ids" widget="many2many_tags" placeholder="Recipients"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
