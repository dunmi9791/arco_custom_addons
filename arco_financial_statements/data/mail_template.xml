<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_monthly_pl" model="mail.template">
        <field name="name">ARCO: Monthly P&amp;L</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="subject">{{ object.name }} - Profit &amp; Loss {{ ctx.get('arco_period', '') }}</field>
        <field name="email_from">{{ object.email or user.email }}</field>
        <field name="body_html" type="html">
<div>
    <p>Dear Management,</p>
    <p>Attached is the Profit &amp; Loss statement of <t t-out="object.name or ''"/> for
        <t t-out="ctx.get('arco_period', '')"/>, with the same period last year for comparison.</p>
    <p>The figures are generated automatically from posted entries in SMERP.</p>
    <p>Finance</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
