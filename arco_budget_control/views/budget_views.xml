<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget items -->
    <record id="view_arco_budget_item_list" model="ir.ui.view">
        <field name="name">arco.budget.item.list</field>
        <field name="model">arco.budget.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="account_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_arco_budget_item" model="ir.actions.act_window">
        <field name="name">Budget Items</field>
        <field name="res_model">arco.budget.item</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Budget lines (budget vs actual) -->
    <record id="view_arco_budget_line_list" model="ir.ui.view">
        <field name="name">arco.budget.line.list</field>
        <field name="model">arco.budget.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="available_amount &lt; 0" decoration-warning="utilisation_pct &gt;= 90 and available_amount &gt;= 0">
                <field name="budget_id" optional="show"/>
                <field name="analytic_account_id"/>
                <field name="analytic_plan_id" optional="hide"/>
                <field name="item_id"/>
                <field name="original_amount" sum="Original" optional="hide"/>
                <field name="transfer_amount" sum="Transfers" optional="hide"/>
                <field name="planned_amount" sum="Budget"/>
                <field name="actual_amount" sum="Actual"/>
                <field name="committed_amount" sum="Committed"/>
                <field name="available_amount" sum="Available"/>
                <field name="variance_amount" sum="Variance" optional="show"/>
                <field name="utilisation_pct" widget="progressbar"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_arco_budget_line_search" model="ir.ui.view">
        <field name="name">arco.budget.line.search</field>
        <field name="model">arco.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="budget_id"/>
                <field name="analytic_account_id"/>
                <field name="item_id"/>
                <filter name="approved" string="Approved Budgets" domain="[('budget_state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_analytic" string="Cost Centre / Project" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_plan" string="Analytic Plan" context="{'group_by': 'analytic_plan_id'}"/>
                    <filter name="group_item" string="Budget Item" context="{'group_by': 'item_id'}"/>
                    <filter name="group_budget" string="Budget" context="{'group_by': 'budget_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_arco_budget_vs_actual" model="ir.actions.act_window">
        <field name="name">Budget vs Actual</field>
        <field name="res_model">arco.budget.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>

    <!-- Budgets -->
    <record id="view_arco_budget_list" model="ir.ui.view">
        <field name="name">arco.budget.list</field>
        <field name="model">arco.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="control_policy"/>
                <field name="planned_total"/>
                <field name="actual_total"/>
                <field name="committed_total"/>
                <field name="available_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
    <record id="view_arco_budget_form" model="ir.ui.view">
        <field name="name">arco.budget.form</field>
        <field name="model">arco.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve Budget" type="object" class="btn-primary" invisible="state != 'draft'" groups="arco_base.group_arco_finance_director"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'approved'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="arco_base.group_arco_finance_director"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-bar-chart" string="Budget vs Actual"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. FY2027 Operating Budget" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="control_policy"/>
                        </group>
                        <group>
                            <field name="approved_by" invisible="not approved_by"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom" decoration-danger="available_amount &lt; 0">
                            <field name="analytic_account_id"/>
                            <field name="item_id"/>
                            <field name="original_amount" sum="Original" readonly="parent.state != 'draft'"/>
                            <field name="transfer_amount" sum="Transfers" optional="show"/>
                            <field name="planned_amount" sum="Budget"/>
                            <field name="actual_amount" sum="Actual"/>
                            <field name="committed_amount" sum="Committed"/>
                            <field name="available_amount" sum="Available"/>
                            <field name="utilisation_pct" widget="progressbar"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="planned_total"/>
                        <field name="actual_total"/>
                        <field name="committed_total"/>
                        <field name="available_total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_arco_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">arco.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_arco_budget_root" name="Budgets" parent="account.menu_finance" sequence="4" groups="account.group_account_invoice,arco_base.group_arco_finance_approver"/>
    <menuitem id="menu_arco_budget" name="Budgets" parent="menu_arco_budget_root" action="action_arco_budget" sequence="1"/>
    <menuitem id="menu_arco_budget_vs_actual" name="Budget vs Actual" parent="menu_arco_budget_root" action="action_arco_budget_vs_actual" sequence="2"/>
    <menuitem id="menu_arco_budget_item" name="Budget Items" parent="menu_arco_budget_root" action="action_arco_budget_item" sequence="9"/>
</odoo>
