<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner flag -->
    <record id="view_partner_form_arco_ncd" model="ir.ui.view">
        <field name="name">res.partner.form.arco.ncd</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="arco_base.view_partner_form_arco"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='arco_vendor_approved']" position="after">
                <field name="arco_ncd_applicable"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice / bill -->
    <record id="view_move_form_arco_ncd" model="ir.ui.view">
        <field name="name">account.move.form.arco.ncd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="arco_ng_wht.view_move_form_arco_wht"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_arco_apply_wht']" position="after">
                <button name="action_arco_apply_ncd" string="Apply NCD 1%" type="object"
                        invisible="state != 'draft' or move_type not in ('in_invoice','in_refund','out_invoice','out_refund')"/>
            </xpath>
            <xpath expr="//page[@name='arco_wht']" position="after">
                <page string="NCD Levy" name="arco_ncd" invisible="move_type not in ('in_invoice','in_refund','out_invoice','out_refund')">
                    <group>
                        <group>
                            <field name="arco_ncd_applicable" readonly="state != 'draft'"/>
                            <field name="arco_ncd_contract_ref"/>
                        </group>
                        <group>
                            <field name="arco_ncd_amount"/>
                            <button name="action_arco_remove_ncd" string="Remove NCD" type="object" class="btn-link"
                                    invisible="state != 'draft' or not arco_ncd_amount"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- NCD levy register (move lines) -->
    <record id="view_arco_ncd_register_list" model="ir.ui.view">
        <field name="name">account.move.line.ncd.register</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="move_id" string="Document"/>
                <field name="partner_id" string="Partner"/>
                <field name="tax_line_id" string="NCD Tax"/>
                <field name="tax_base_amount" string="Contract Value (Base)" sum="Base"/>
                <field name="balance" string="NCD Amount" sum="NCD"/>
                <field name="arco_ncd_remittance_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_arco_ncd_register_pivot" model="ir.ui.view">
        <field name="name">account.move.line.ncd.pivot</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_arco_ncd_register_search" model="ir.ui.view">
        <field name="name">account.move.line.ncd.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <filter name="unremitted" string="Not Remitted" domain="[('arco_ncd_remittance_id', '=', False)]"/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_arco_ncd_payable" model="ir.actions.act_window">
        <field name="name">NCD Deducted from Vendors (Payable to NCDF)</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_arco_ncd_register_list')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_arco_ncd_register_pivot')})]"/>
        <field name="search_view_id" ref="view_arco_ncd_register_search"/>
        <field name="domain">[('tax_line_id.arco_tax_kind', '=', 'ncd'), ('tax_line_id.type_tax_use', '=', 'purchase'), ('parent_state', '=', 'posted')]</field>
    </record>
    <record id="action_arco_ncd_suffered" model="ir.actions.act_window">
        <field name="name">NCD Deducted by Customers</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_arco_ncd_register_list')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_arco_ncd_register_pivot')})]"/>
        <field name="search_view_id" ref="view_arco_ncd_register_search"/>
        <field name="domain">[('tax_line_id.arco_tax_kind', '=', 'ncd'), ('tax_line_id.type_tax_use', '=', 'sale'), ('parent_state', '=', 'posted')]</field>
    </record>

    <!-- Remittance -->
    <record id="view_arco_ncd_remittance_list" model="ir.ui.view">
        <field name="name">arco.ncd.remittance.list</field>
        <field name="model">arco.ncd.remittance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="payment_date"/>
                <field name="ncdmb_receipt"/>
                <field name="base_amount" sum="Base"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>
    <record id="view_arco_ncd_remittance_form" model="ir.ui.view">
        <field name="name">arco.ncd.remittance.form</field>
        <field name="model">arco.ncd.remittance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" string="Collect Deductions" type="object" invisible="state != 'draft'"/>
                    <button name="action_post" string="Post Remittance" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'" confirm="Reverse the remittance entry and release the deductions?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="ncdmb_receipt"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="base_amount"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1" context="{'tree_view_ref': 'arco_ng_ncd.view_arco_ncd_register_list'}">
                        <list>
                            <field name="date"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="tax_base_amount" string="Base" sum="Base"/>
                            <field name="balance" string="NCD" sum="NCD"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_arco_ncd_remittance" model="ir.actions.act_window">
        <field name="name">NCD Remittances</field>
        <field name="res_model">arco.ncd.remittance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_arco_ncd_root" name="NCD Levy (NCDF)" parent="account.menu_finance_reports" sequence="6"/>
    <menuitem id="menu_arco_ncd_payable" name="NCD Deducted from Vendors" parent="menu_arco_ncd_root" action="action_arco_ncd_payable" sequence="1"/>
    <menuitem id="menu_arco_ncd_suffered" name="NCD Deducted by Customers" parent="menu_arco_ncd_root" action="action_arco_ncd_suffered" sequence="2"/>
    <menuitem id="menu_arco_ncd_remittance" name="NCD Remittances" parent="menu_arco_ncd_root" action="action_arco_ncd_remittance" sequence="3"/>

    <!-- Settings -->
    <record id="res_config_settings_view_form_arco_ncd" model="ir.ui.view">
        <field name="name">res.config.settings.arco.ncd</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="NCD Levy (NCDF 1%)" id="arco_ncd_settings">
                    <setting string="Auto-apply NCD" help="Add the NCD levy on posting for partners flagged NCD applicable">
                        <field name="arco_ncd_auto_apply"/>
                    </setting>
                    <setting string="NCD Taxes" help="Deduction-at-source taxes used for the NCD levy">
                        <div class="content-group">
                            <div class="row"><label for="arco_ncd_sale_tax_id" class="col-lg-5"/><field name="arco_ncd_sale_tax_id"/></div>
                            <div class="row"><label for="arco_ncd_purchase_tax_id" class="col-lg-5"/><field name="arco_ncd_purchase_tax_id"/></div>
                            <button name="action_arco_setup_ncd" type="object" string="Create NCD accounts and taxes" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
